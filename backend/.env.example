# ═══════════════════════════════════════════════════════════
# CUBEMINE Backend — Environment Variables Example
# Copy this file to .env and fill in your actual values.
# ═══════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB Atlas ─────────────────────────────────────────
# Get from: https://cloud.mongodb.com
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars
JWT_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# Google OAuth
# Authorized JavaScript origin for local dev: http://localhost:3000
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ── Redis Caching (Upstash) ───────────────────────────────
# Option A: Upstash REST API (recommended for serverless)
# Get from: https://console.upstash.com → Your DB → REST API tab
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Option B: Standard Redis via ioredis (Upstash TLS URL or local)
# Format: rediss://default:<password>@<endpoint>:<port>
REDIS_URL=
